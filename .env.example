# Copy this file to .env and fill in the keys you use. Never commit .env.

# ── Database ─────────────────────────────────────────
DATABASE_URL=sqlite:///./data/marketing.db

# ── Gemini (company search, competitor search, post images) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: a different model for the Google Search calls, and a backup model when Gemini is busy.
GEMINI_SEARCH_MODEL=
GEMINI_FALLBACK_MODEL=

# ── Company and competitor search ────────────────────
# auto = Serper Google results + Gemini Google search when SERPER_API_KEY is set, else Gemini only
# grounded = Gemini Google search only, serper = Serper only
COMPETITOR_SEARCH=auto
# Serper (https://serper.dev): Google search results, also used for the "Web & news" source.
SERPER_API_KEY=

# ── Collecting rivals (M0) ───────────────────────────
# Apify (https://console.apify.com/settings/integrations): Facebook, Instagram, LinkedIn and Meta ads.
APIFY_API_TOKEN=
APIFY_RUN_TIMEOUT_SECONDS=180
# Apify budget per month in USD; Apify sources pause at 90%. Highest cost of one run.
WATCH_APIFY_MONTHLY_USD=5
WATCH_APIFY_MAX_USD_PER_RUN=0.25
# Instagram posts and reels asked from Apify on each visit (0 skips that scraper).
WATCH_IG_POSTS=24
WATCH_IG_REELS=12
# Meta Ad Library country and the country for the web and news search.
WATCH_ADS_COUNTRY=EG
WATCH_SEARCH_COUNTRY=eg
# Optional free Instagram data (Meta Business Discovery): your own Instagram business account id and a token.
META_IG_USER_ID=
META_ACCESS_TOKEN=
# 0 turns automatic collection off (the Collect buttons still work).
WATCH_SCHEDULER=1
# Website screenshots kept per page (0 in WATCH_SCREENSHOTS turns screenshots off).
WATCH_SCREENSHOTS=1
WATCH_KEEP_SCREENSHOTS=5
# Hours from UTC for the Sunday brief and Monday email (Cairo = 3).
WATCH_UTC_OFFSET_HOURS=3
PLAYWRIGHT_TIMEOUT=30000

# ── n8n workflows (see n8n/README.md) ────────────────
# Defaults: http://localhost:5678/webhook/radar-signals, radar-weekly, radar-strategy and radar-content.
N8N_SIGNALS_WEBHOOK_URL=
N8N_WEEKLY_WEBHOOK_URL=
N8N_STRATEGY_WEBHOOK_URL=
N8N_CONTENT_WEBHOOK_URL=
# Optional. Needed only when n8n runs on another machine: put the same value in each workflow's Settings node (radar_token).
N8N_SHARED_TOKEN=
# Optional. Address n8n uses to reach Radar; defaults to http://127.0.0.1:8000.
RADAR_CALLBACK_URL=

# ── Post images (M2) ─────────────────────────────────
# Free images with FLUX.2 on Cloudflare Workers AI.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional: CLOUDFLARE_IMAGE_MODEL (default @cf/black-forest-labs/flux-2-klein-4b),
# IMAGE_PROVIDER=cloudflare|gemini, GEMINI_IMAGE_MODEL (paid Gemini keys only).
CLOUDFLARE_IMAGE_MODEL=
IMAGE_PROVIDER=
GEMINI_IMAGE_MODEL=

# ── Weekly brief email (Gmail: SMTP_PASSWORD is an app password) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Comma separated.
BRIEF_EMAIL_TO=

# ── Security (accounts and network access) ───────────
# Host names / IPs people use to reach Radar. Requests with any other Host header are refused.
# Add your PC's LAN IP or domain to share it, e.g. ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.20
ALLOWED_HOSTS=localhost,127.0.0.1
# auto = Secure cookies when the page is served over HTTPS. Set 1 behind an HTTPS reverse proxy.
COOKIE_SECURE=auto
# Self sign-up: approval (an admin approves each new account), viewer (read-only at once), off.
SIGNUP_MODE=approval
SESSION_IDLE_HOURS=12
SESSION_MAX_HOURS=168
# Per-user limits on the steps that spend API quota or CPU.
LIMIT_SEARCHES_PER_10_MIN=20
LIMIT_PLANS_PER_HOUR=12
LIMIT_CONTENT_RUNS_PER_HOUR=6
LIMIT_WATCH_RUNS_PER_HOUR=12
MAX_REQUEST_BYTES=1048576
# The website collector refuses localhost and private network addresses. Set 1 only for an intranet site.
SCRAPE_ALLOW_PRIVATE_NETWORK=
