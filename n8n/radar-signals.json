      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"signals\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"change_id\": {\n            \"type\": \"integer\"\n          },\n          \"score\": {\n            \"type\": \"integer\"\n          },\n          \"reason\": {\n            \"type\": \"string\"\n          },\n          \"meaning\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"change_id\",\n          \"score\",\n          \"reason\",\n          \"meaning\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"signals\"\n  ]\n}"
      },
